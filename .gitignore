# ============================================================
# Moi truong Python - 5.4 GB, KHONG THE push
# GitHub chan cung file > 100MB, ma .venv co 14 file vuot
# (lon nhat: libcublasLt.so.13 = 517 MB)
# Tao lai: python3.13 -m venv .venv && pip install -r requirements.txt
# ============================================================
.venv/
__pycache__/
*.pyc
*.pyo

# ============================================================
# Ba repo duoi day DUOC dua vao repo nay (vendored), nhung .git
# goc cua chung da doi ten thanh .git-upstream de git cha khong
# hieu nham la submodule. KHONG commit phan lich su do (216 MB).
#
# Muon pull ban moi tu upstream:
#     mv unitree_rl_gym/.git-upstream unitree_rl_gym/.git
#     git -C unitree_rl_gym pull
#     mv unitree_rl_gym/.git unitree_rl_gym/.git-upstream
# ============================================================
.git-upstream/

# ============================================================
# San pham bien dich - tao lai duoc, va chua duong dan TUYET DOI
# nen hong tren may khac
# ============================================================
g1_ws/build/
g1_ws/install/
g1_ws/log/
.colcon_*
COLCON_IGNORE

# Ket qua chay thu
*.pcd
*.bag
g1_ws/src/fast_lio/Log/
g1_ws/src/fast_lio/PCD/

# Cau hinh cuc bo cua may
.claude/settings.local.json

# He dieu hanh / editor
.DS_Store
*.swp
*~
