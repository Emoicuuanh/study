<mujoco model="cartpole">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.02"/>
  </default>

  <worldbody>
    <geom type="plane" size="3 1 0.1" rgba="0.85 0.87 0.92 1"/>
    <body name="rail" pos="0 0 1">
      <geom type="cylinder" fromto="-1.2 0 0  1.2 0 0" size="0.008" rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>
      <body name="cart" pos="0 0 0">
        <joint name="slider" type="slide" axis="1 0 0" limited="true" range="-1.1 1.1"/>
        <geom type="box" size="0.1 0.08 0.05" rgba="0.14 0.31 0.85 1" mass="1.0"/>
        <body name="pole" pos="0 0 0">
          <joint name="hinge" type="hinge" axis="0 1 0" pos="0 0 0"/>
          <geom type="capsule" fromto="0 0 0  0 0 0.5" size="0.015" rgba="0.78 0.42 0.02 1" mass="0.1"/>
          <geom type="sphere" pos="0 0 0.5" size="0.03" rgba="0.78 0.42 0.02 1" mass="0.05"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor joint="slider" name="cart_motor" ctrlrange="-25 25"/>
  </actuator>
</mujoco>
